---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getLocaleFromUrl, localizedPath } from '../i18n/utils';
import { getThumbnail } from '../utils/media';

interface Props {
  play: CollectionEntry<'parastaseis'>;
}
const { play } = Astro.props;
const d = play.data;
const thumb = getThumbnail(d);
const locale = getLocaleFromUrl(Astro.url);
const href = localizedPath(`/parastaseis/${play.id}`, locale);
---

<!-- Editorial, image-led card: flat — no box, no border, no shadow.
     Photo at its native 3:2, year as orange eyebrow, serif title. -->
<article class="group">
  <a href={href} class="block">
    {
      thumb ? (
        <div class="overflow-hidden">
          <Image
            src={thumb}
            alt={d.title}
            widths={[240, 480, 640]}
            sizes="(min-width:1024px) 33vw,(min-width:640px) 50vw,100vw"
            width={640}
            height={427}
            class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
          />
        </div>
      ) : (
        <div class="flex aspect-[3/2] w-full items-center justify-center bg-zinc-950/5 px-4 text-center font-display text-2xl text-zinc-950/40">
          {d.title}
        </div>
      )
    }
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-orange">
      {d.year}
    </p>
    <h3 class="mt-1 font-display text-2xl leading-snug text-zinc-950 transition group-hover:text-orange">
      {d.title}
    </h3>
    {d.writer && <p class="mt-1 text-sm text-zinc-600">{d.writer}</p>}
  </a>
</article>
