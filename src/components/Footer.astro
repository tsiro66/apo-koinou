---
import { SITE, NAV_LINKS, BRAND } from '../consts';
import { Image } from 'astro:assets';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import RollLink from './RollLink.astro';
import logo from '../assets/logos/logo-white.png';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-zinc-50/10 bg-zinc-950 text-zinc-50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <Image
        src={logo}
        alt={brand.title}
        widths={[480, 960]}
        sizes="(min-width: 640px) 30vw, calc(100vw - 2rem)"
        class="max-h-30 max-w-full"
      />
      <p class="mt-3 text-sm text-zinc-50/70">{brand.tagline}</p>
    </div>

    <nav aria-label={t('footer.nav_aria')}>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <RollLink
                href={localizedPath(link.href, locale)}
                label={t(link.labelKey)}
                class="text-zinc-50/80"
                rollClass="text-zinc-50"
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm text-zinc-50/70">
      <a
        href={`mailto:${SITE.email}`}
        class="text-zinc-50 underline-offset-2 transition hover:text-orange"
      >
        {SITE.email}
      </a>
      <a
        href={`tel:${SITE.phone}`}
        class="mt-1 block text-zinc-50 underline-offset-2 transition hover:text-orange"
      >
        {SITE.phone}
      </a>
      <p class="mt-3">© {year} {brand.title}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>