---
// Featured repertoire block: a full-width editorial split used for
// every play on /repertorio. Photo left at its native 3:2 (~60%), text
// column right: date-range eyebrow, serif title, writer, season blurb
// and this season's shows (date — venue). The whole block points at the
// repertoire detail page. Blocks alternate the photo side for rhythm
// between consecutive plays.
import type { RepertoireEntry } from "../utils/repertoire";
import { Image } from "astro:assets";
import {
  getLocaleFromUrl,
  localizedPath,
  formatDate,
  useTranslations,
} from "../i18n/utils";
import {
  performanceRange,
  sortShows,
  formatShowDate,
} from "../utils/repertoire";

interface Props {
  entry: RepertoireEntry;
  /** Even-indexed blocks lead with the photo, odd ones trail it. */
  index?: number;
}
const { entry, index = 0 } = Astro.props;
const d = entry.data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = localizedPath(`/repertorio/${entry.id}`, locale);

// This season's shows, soonest first; the eyebrow carries the whole
// range, the list shows each date (or date range) with its venue.
const shows = sortShows(d.performances);
const eyebrow = performanceRange(d.performances, locale) ?? String(d.year);
---

<article class="group grid gap-8 lg:grid-cols-5 lg:items-center lg:gap-14">
  <a
    href={href}
    class={`block overflow-hidden max-lg:order-first ${index % 2 === 1 ? "lg:order-last lg:col-span-3" : "lg:col-span-3"}`}
  >
    {
      d.thumbnail ? (
        <Image
          src={d.thumbnail}
          alt={d.title}
          widths={[480, 768, 1024, 1280]}
          sizes="(min-width:1024px) 60vw, 100vw"
          width={1280}
          height={854}
          class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
        />
      ) : (
        <div class="flex aspect-[3/2] w-full items-center justify-center bg-zinc-950/5 px-4 text-center font-display text-3xl text-zinc-950/40">
          {d.title}
        </div>
      )
    }
  </a>

  <div
    class={index % 2 === 1 ? "lg:order-first lg:col-span-2" : "lg:col-span-2"}
  >
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-orange">
      {eyebrow}
    </p>
    <h2
      class="mt-3 font-display text-3xl leading-tight text-zinc-950 sm:text-4xl"
    >
      <a href={href} class="transition hover:text-orange">
        {d.title}
      </a>
      <span class="font-normal text-zinc-950/50"> ({d.year})</span>
    </h2>
    {d.writer && <p class="mt-2 text-lg text-zinc-600">{d.writer}</p>}
    {
      d.summary && (
        <p class="mt-5 leading-relaxed text-zinc-950/80">{d.summary}</p>
      )
    }
    {
      shows.length > 0 && (
        <dl class="mt-6 space-y-2 text-sm">
          {shows.map((p) => (
            <div class="flex flex-wrap items-baseline gap-x-3">
              <dt class="font-semibold text-zinc-950">
                {formatShowDate(p, locale)}
              </dt>
              <dd class="text-orange">{p.venue}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <a
      href={href}
      class="mt-8 inline-block bg-zinc-950 px-6 py-3 text-sm font-semibold uppercase tracking-wider text-zinc-50 transition hover:bg-orange"
    >
      {t("prod.see_more")}
    </a>
  </div>
</article>
