---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import heroBg from "../../assets/bg.jpg";
import { getVideoId } from "../../utils/media";
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
  format,
} from "../../i18n/utils";

interface Props {
  /** Carousel productions with a photo, newest first, max five. */
  slides: { play: CollectionEntry<"parastaseis">; thumb: ImageMetadata }[];
}
const { slides } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const hasSlides = slides.length > 0;
---

<!-- Hero: full-bleed photo carousel of the productions picked for the
     front page (newest first, max five; falls back to the most recent
     productions when none are picked).
     No visible heading: the photography carries the hero, with only a
     watch-now button bottom-right. Height: 70svh on phones — the
     featured section peeks above the fold — full viewport from sm up.
     The navbar overlays it in overlay mode and flips to solid as the
     hero exits. The first slide is eager + high fetch priority: it is the
     LCP element. The negative top margin pulls the photos up under the
     transparent navbar (sticky headers occupy flow space). It must
     match the resting bar height exactly: nav py-2 + h-10 = 3.5rem. -->
<section
  data-hero
  data-carousel
  class="relative -mx-4 -mt-14 flex min-h-[70svh] items-end overflow-hidden bg-zinc-950 sm:min-h-svh"
>
  {
    hasSlides ? (
      // z-0 gives the slides their own stacking context: their z-index
      // juggling stays below the gradients and hero content.
      <div
        class="absolute inset-0 z-0"
        role="region"
        aria-roledescription="carousel"
        aria-label={t("home.hero.carousel_aria")}
      >
        {slides.map(({ play, thumb }, i) => (
          <div
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={format(t("home.hero.slide_label"), {
              index: i + 1,
              total: slides.length,
            })}
            aria-hidden={i !== 0}
            class:list={[
              "hero-slide absolute inset-0",
              { "is-active": i === 0 },
            ]}
          >
            <Image
              src={thumb}
              alt={play.data.title}
              widths={[768, 1280, 1920, 2560]}
              sizes="100vw"
              width={1920}
              height={1280}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              class="h-full w-full object-cover"
            />
          </div>
        ))}
      </div>
    ) : (
      // No production photos yet: static fallback shot.
      <Image
        src={heroBg}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        width={1920}
        height={1280}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )
  }
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/35 to-zinc-950/10"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-zinc-950/60 to-transparent"
  >
  </div>
  <!-- The site title stays as a screen-reader h1: the page keeps its
       document outline (and SEO signal) without covering the photos. -->
  <h1 class="sr-only">{t("site.title")}</h1>
  <!-- Carousel chrome: a watch-now button (only for productions with
       video) bottom-right, slide indicators centered below it. Manual
       navigation: dots plus a horizontal swipe on touch — no arrow
       chrome over the photography. Hidden entirely when there is
       nothing to show. -->
  {
    hasSlides && (
      <div class="absolute inset-x-4 bottom-6 z-10 flex flex-col gap-4 sm:inset-x-6 sm:bottom-8">
        <div class="grid w-full justify-items-end">
          {slides.map(({ play }, i) => (
            <div
              data-caption
              aria-hidden={i !== 0}
              class:list={[
                "hero-caption col-start-1 row-start-1 flex flex-col items-end",
                { "is-active": i === 0 },
              ]}
            >
              {getVideoId(play.data) && (
                <a
                  href={`${localizedPath(`/parastaseis/${play.id}`, locale)}#parastasi`}
                  tabindex={i === 0 ? undefined : -1}
                  class="bg-orange px-4 py-2.5 text-sm font-semibold text-zinc-50 transition hover:bg-zinc-100 hover:text-zinc-950"
                >
                  {t("prod.watch_now")}
                </a>
              )}
            </div>
          ))}
        </div>
        {slides.length > 1 && (
          <div
            class="flex justify-center gap-2"
            role="group"
            aria-label={t("home.hero.dots_aria")}
          >
            {slides.map(({ play }, i) => (
              <button
                data-dot
                type="button"
                aria-label={format(t("home.hero.dot_aria"), {
                  title: play.data.title,
                })}
                aria-current={i === 0 ? "true" : undefined}
                class:list={[
                  "h-1 w-6 transition-colors",
                  i === 0 ? "bg-orange" : "bg-zinc-50/40 hover:bg-zinc-50/70",
                ]}
              />
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<script src="./HeroCarousel.ts"></script>

<style>
  /* Hero carousel: the incoming slide (.is-active) fades in on top of the
     previous one (.is-under, kept fully opaque) so the photo cross-fades
     without dipping to the dark background. Reduced motion: instant swap. */
  .hero-slide {
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }
  .hero-slide.is-under {
    z-index: 1;
    opacity: 1;
  }
  .hero-slide.is-active {
    z-index: 2;
    opacity: 1;
  }
  /* Captions share one grid cell; only the active one is visible and
     interactive (stacked links must not catch clicks or focus). */
  .hero-caption {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease-in-out;
  }
  .hero-caption.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-caption {
      transition: none;
    }
  }
</style>
