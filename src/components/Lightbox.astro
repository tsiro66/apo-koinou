---
import { getLocaleFromUrl, useTranslations } from "../i18n/utils";

// Shared photo lightbox: a modal <dialog> wired to every [data-lightbox-src]
// trigger on the page. Triggers carry data-lightbox-src (full-size URL) and
// data-lightbox (group name); triggers sharing a group form a browsable set
// with prev/next arrows and ←/→/Esc keys. The dialog lives once per page and
// is reused by all groups (play gallery, invitation, program, /syllogi grids).
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<dialog
  data-lightbox-dialog
  aria-label={t("common.photo")}
  class="fixed inset-0 z-[70] m-0 h-full max-h-none w-full max-w-none bg-zinc-950/95 p-0 backdrop:bg-transparent"
>
  <div class="relative flex h-full w-full items-center justify-center">
    <img
      data-lightbox-img
      src=""
      alt=""
      class="max-h-full max-w-full object-contain select-none"
    />

    <!-- Close, top-right. -->
    <button
      data-lightbox-close
      type="button"
      aria-label={t("lightbox.close")}
      class="absolute top-4 right-4 flex h-11 w-11 items-center justify-center border border-zinc-50/40 text-zinc-50/80 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-5 w-5">
        <path
          d="m4 4 8 8m0-8-8 8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- Prev/next, screen edges (hidden for single-photo sets). -->
    <button
      data-lightbox-prev
      type="button"
      aria-label={t("lightbox.prev")}
      class="absolute top-1/2 left-3 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-zinc-50/40 text-zinc-50/80 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:left-6"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-5 w-5">
        <path
          d="m10 4-4 4 4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      data-lightbox-next
      type="button"
      aria-label={t("lightbox.next")}
      class="absolute top-1/2 right-3 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-zinc-50/40 text-zinc-50/80 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:right-6"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-5 w-5">
        <path
          d="m6 4 4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</dialog>

<script src="./Lightbox.ts"></script>

<style>
  dialog[data-lightbox-dialog] {
    /* Native dialogs get a UA margin/border; strip both for full-bleed. */
    margin: 0;
    border: none;
  }
  dialog[data-lightbox-dialog]:not([open]) {
    display: none;
  }
</style>
