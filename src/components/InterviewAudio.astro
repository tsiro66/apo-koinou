---
// Custom audio player card for voice interviews (Συνεντεύξεις — Ήχος).
// Native <audio> controls look like a browser widget and clash with the
// site language, so this renders its own: orange play/pause square,
// seek bar (input[type=range], accent-color — keyboard accessible for
// free), current/total time. Behavior lives in InterviewAudio.ts.
// preload="metadata" loads only the header (duration) — the audio
// itself is fetched when the visitor presses play.
import { getLocaleFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  /** Site-absolute path, e.g. /syneunteixeis/glaros/radio.mp3. */
  src: string;
  title?: string;
  /** Free-text date, Greek prose ("Μάρτιος 2023"). */
  date?: string;
}
const { src, title, date } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<div
  data-audio-player
  data-label-play={t("prod.interviews_play")}
  data-label-pause={t("prod.interviews_pause")}
  class="border border-zinc-950/15 bg-zinc-950 p-4"
>
  <div class="flex items-center gap-4">
    <button
      type="button"
      data-audio-play
      aria-label={t("prod.interviews_play")}
      class="grid h-12 w-12 shrink-0 cursor-pointer place-items-center bg-orange text-zinc-50 transition hover:bg-zinc-50 hover:text-zinc-950"
    >
      <svg
        data-audio-icon-play
        viewBox="0 0 24 24"
        class="h-5 w-5 fill-current"
        aria-hidden="true"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg
        data-audio-icon-pause
        viewBox="0 0 24 24"
        class="hidden h-5 w-5 fill-current"
        aria-hidden="true"
      >
        <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
      </svg>
    </button>
    <div class="min-w-0 flex-1">
      {
        (title || date) && (
          <p class="truncate text-sm font-semibold text-zinc-50">
            {title}
            {date && (
              <span class="ml-2 font-normal text-zinc-50/50">{date}</span>
            )}
          </p>
        )
      }
      <input
        type="range"
        data-audio-seek
        min="0"
        max="100"
        step="any"
        value="0"
        aria-label={t("prod.interviews_seek")}
        class="audio-seek"
      />
      <div
        class="mt-1 flex justify-between text-xs tabular-nums text-zinc-50/50"
      >
        <span data-audio-current>0:00</span>
        <span data-audio-duration>&ndash;:&ndash;&ndash;</span>
      </div>
    </div>
  </div>
  <audio data-audio-el src={src} preload="metadata" class="hidden"></audio>
</div>

<script src="./InterviewAudio.ts"></script>

<style>
  /* Custom seek bar: native range styling looks like a widget and
     (with accent-color) paints a light track on the dark card. Full
     appearance reset instead — hairline track, orange fill up to the
     --fill percentage (set by InterviewAudio.ts), square orange thumb
     matching the site's sharp-corner language. */
  .audio-seek {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: 1rem; /* comfortable touch target */
    margin-top: 0.5rem;
    background: transparent;
    cursor: pointer;
  }
  .audio-seek::-webkit-slider-runnable-track {
    height: 3px;
    background: linear-gradient(
      to right,
      var(--color-orange) var(--fill, 0%),
      rgb(255 255 255 / 0.2) var(--fill, 0%)
    );
  }
  .audio-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    height: 13px;
    width: 13px;
    margin-top: -5px; /* center on the 3px track */
    border: none;
    border-radius: 0;
    background: var(--color-orange);
  }
  .audio-seek::-moz-range-track {
    height: 3px;
    background: linear-gradient(
      to right,
      var(--color-orange) var(--fill, 0%),
      rgb(255 255 255 / 0.2) var(--fill, 0%)
    );
  }
  .audio-seek::-moz-range-thumb {
    height: 13px;
    width: 13px;
    border: none;
    border-radius: 0;
    background: var(--color-orange);
  }
</style>
