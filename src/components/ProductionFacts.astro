---
// Label/value rows in the style "Label: value" used by the production
// sections (Θεατρικό έργο, Συντελεστές, Διανομή, Τόπος & Χρόνος).
// Rows with an empty label render just the value (e.g. cast without roles).
// Two columns from sm up: long crew/cast lists (25+ rows on some
// productions) scan far better as a two-column wall than a single one.
interface Fact {
  label: string;
  value: string;
}
interface Props {
  facts: Fact[];
}
const { facts } = Astro.props;
---

<dl class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
  {
    facts.map((f) => (
      <div>
        {f.label && (
          <>
            <dt class="inline font-semibold text-zinc-950">{f.label}:</dt>{" "}
          </>
        )}
        <dd class="inline text-orange">{f.value}</dd>
      </div>
    ))
  }
</dl>
