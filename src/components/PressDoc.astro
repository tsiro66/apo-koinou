---
// Press-clipping card (Δημοσιεύματα — Συνεντεύξεις «Κείμενο»): one link
// card per scanned interview / news article about the production. The
// whole card is an anchor that opens the PDF in a new browser window —
// no inline viewer and no client JS: the browser's own PDF viewer
// (with its download controls) is the universal fallback, mobile
// included.
import { getLocaleFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  /** Site-absolute path, e.g. /parastaseis-docs/glaros/interview.pdf. */
  src: string;
  /** Optional headline, e.g. «Συνέντευξη του σκηνοθέτη». */
  title?: string;
  /** Optional publication / media name, e.g. «Εφημερίδα …». */
  source?: string;
  /** Optional free-text date, Greek prose («Μάρτιος 2023»). */
  date?: string;
}
const { src, title, source, date } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));

// No title set? Fall back to the filename (extension stripped, dashes
// → spaces) so an untitled row still reads like a document label.
const filename = src.split("/").pop() ?? "";
const label = title || filename.replace(/\.pdf$/i, "").replace(/[-_]+/g, " ");
---

<a
  href={src}
  target="_blank"
  rel="noopener"
  class="flex items-center gap-4 border border-zinc-950/15 bg-zinc-950 p-4 transition hover:border-orange"
>
  <span
    class="grid h-12 w-12 shrink-0 place-items-center bg-orange text-zinc-950"
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
      <path
        d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM12.971 1.821A5.25 5.25 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.25 5.25 0 0 1 3.429 1.279 9 9 0 1 0-6.958-6.958Z"
      ></path>
    </svg>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-semibold text-zinc-50">{label}</span>
    {
      (source || date) && (
        <span class="mt-0.5 block text-xs text-zinc-50/50">
          {[source, date].filter(Boolean).join(" · ")}
        </span>
      )
    }
  </span>
  <span
    class="flex shrink-0 items-center gap-1.5 text-xs font-semibold text-orange"
  >
    {t("prod.press_view")}
    <svg
      viewBox="0 0 24 24"
      class="h-3.5 w-3.5 stroke-current"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M7 7h10v10"></path>
    </svg>
  </span>
</a>
