---
// Shared header for the production pages (detail + Υλικό): thumbnail, title
// with year, stage subtitle, anchor buttons for the page sections, and an
// optional top-right column (Watch now button + Υλικό stats menu).
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

export interface HeaderButton {
  href: string;
  label: string;
}
export interface HeaderStat {
  href: string;
  label: string;
  count: number;
}

interface Props {
  play: CollectionEntry<'parastaseis'>;
  buttons?: HeaderButton[];
  stats?: HeaderStat[];
  /** Anchor to the stream section; renders the Watch now button. */
  watchNowHref?: string;
}
const { play, buttons = [], stats = [], watchNowHref } = Astro.props;
const d = play.data;
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<header class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
  {
    d.thumbnail && (
      <Image
        src={d.thumbnail}
        alt={d.title}
        widths={[288, 352, 576]}
        sizes="(min-width:640px) 176px, 144px"
        width={352}
        height={264}
        class="aspect-[4/3] w-36 shrink-0 border border-zinc-950/10 object-cover sm:w-44"
      />
    )
  }

  <div class="min-w-0 flex-1">
    <h1 class="text-3xl text-zinc-950 sm:text-4xl">
      {d.title}
      <span class="font-normal text-zinc-600"> ({d.year})</span>
    </h1>
    {d.stage && <p class="mt-1 text-lg text-zinc-600">{d.stage}</p>}

    {
      buttons.length > 0 && (
        <nav aria-label={d.title} class="mt-6 flex flex-wrap gap-3">
          {buttons.map((b) => (
            <a
              href={b.href}
              class="border border-orange px-4 py-2 text-sm font-semibold text-orange transition hover:bg-orange hover:text-zinc-50"
            >
              {b.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>

  {
    (watchNowHref || stats.length > 0) && (
      <div class="flex shrink-0 flex-col gap-3 sm:items-end sm:text-right">
        {watchNowHref && (
          <a
            href={watchNowHref}
            class="inline-block bg-orange px-4 py-2 text-sm font-semibold text-zinc-50 transition hover:bg-zinc-950"
          >
            {t('prod.watch_now')}
          </a>
        )}
        {stats.length > 0 && (
          <ul class="space-y-1 text-sm">
            {stats.map((s) => (
              <li>
                <a href={s.href} class="font-semibold text-zinc-950 transition hover:text-orange">
                  {s.label} <span class="text-orange">{s.count}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
</header>
