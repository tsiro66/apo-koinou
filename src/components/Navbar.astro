---
import { NAV_LINKS } from "../consts";
import { Image } from "astro:assets";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import RollLink from "./RollLink.astro";
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
  neutralPath,
} from "../i18n/utils";
import { BRAND, SITE } from "../consts";
import logo from "../assets/logos/logo1.png";
import logoWhite from "../assets/logos/logo.png";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];

// The homepage hero runs underneath a transparent navbar (overlay mode).
// The server-rendered default avoids a solid→transparent flash on load;
// the scroll handler below flips it as the hero exits.

// Active-link check uses the locale-neutral path so it works under /en too.
// Navbar hides home (the brand lockup already links there) and syllogi.
// NAV_LINKS itself stays intact for the footer.
const NAV_HIDDEN = new Set<string>(["/", "/syllogi"]);
const navLinks = NAV_LINKS.filter((l) => !NAV_HIDDEN.has(l.href));

const neutral = neutralPath(Astro.url);
const isHome = neutral === "/";
const isActive = (href: string) =>
  href === "/" ? neutral === "/" : neutral.startsWith(href);

// Active-page marker: the exact same primitive as the locale switcher —
// a border-b-2 on the anchor itself (aria-current), so both underlines
// always render identically. The RollLink box is fixed-height with
// box-sizing: border-box, so the border eats into the descender padding
// (Greek caps have none) instead of shifting the layout.
const activeLinkMarker = "aria-[current=page]:border-b-2 aria-[current=page]:border-orange";
---

<div id="nav-menu" class="contents" data-open="false">
  <header
    data-mode={isHome ? "overlay" : "solid"}
    class="sticky top-0 z-50 bg-zinc-50"
  >
    <nav
      aria-label={t("nav.main_aria")}
      class="mx-auto flex max-w-6xl items-center justify-between gap-x-8 px-6 py-2 sm:px-10"
    >
      <!-- Left: brand lockup with primary links grouped beside it -->
      <div class="flex items-center gap-8 xl:gap-12">
        <!-- Brand: full logo lockup (masks + wordmark). -->
        <a
          href={localizedPath("/", locale)}
          class="flex items-center"
          aria-label={brand.title}
        >
          <Image
            src={logo}
            alt={brand.title}
            widths={[128, 256, 384]}
            sizes="(min-width: 640px) 90px, 80px"
            class="logo-dark h-9 w-auto sm:h-10"
          />
          <Image
            src={logoWhite}
            alt={brand.title}
            widths={[128, 256, 384]}
            sizes="(min-width: 640px) 90px, 80px"
            class="logo-light h-9 w-auto sm:h-10"
          />
        </a>
        <ul class="hidden items-center gap-6 font-sans lg:flex xl:gap-10">
          {
            navLinks.map((link) => (
              <li class="relative">
                <RollLink
                  href={localizedPath(link.href, locale)}
                  label={t(link.labelKey)}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "text-sm font-semibold tracking-[0.15em] uppercase text-(--nav-fg) transition-colors duration-300 aria-[current=page]:text-orange",
                    activeLinkMarker,
                  ]}
                  rollClass="text-orange"
                />
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: language picker + menu toggle (mobile/tablet) -->
      <div class="flex items-center gap-6 sm:gap-8">
        <div class="lg:pl-6 xl:pl-8">
          <LocaleSwitcher />
        </div>
        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle relative flex h-10 w-12 cursor-pointer items-center justify-center text-(--nav-fg) transition-colors duration-300 lg:hidden"
          aria-label={t("common.open_menu")}
          data-label-open={t("common.open_menu")}
          data-label-close={t("common.close_menu")}
          aria-expanded="false"
          aria-controls="nav-overlay"
        >
          <span class="bar bar1"></span>
          <span class="bar bar2"></span>
        </button>
      </div>
    </nav>
  </header>

  <!-- Fullscreen menu overlay (mobile/tablet only). `inert` keeps it out of
       the tab order and accessibility tree while closed; JS toggles it. -->
  <div
    id="nav-overlay"
    inert
    class="overlay fixed inset-0 z-40 flex flex-col overflow-y-auto bg-zinc-50 px-6 pt-20 sm:pt-24 lg:hidden"
  >
    <nav
      aria-label={t("nav.main_aria")}
      class="flex flex-1 items-center justify-center py-8"
    >
      <ul
        class="flex flex-col items-center gap-6 text-center sm:grid sm:grid-cols-2 sm:justify-items-center sm:gap-x-12 sm:gap-y-8 md:gap-x-16"
      >
        {
          navLinks.map((link) => (
            <li class="relative">
              <RollLink
                href={localizedPath(link.href, locale)}
                label={t(link.labelKey)}
                aria-current={isActive(link.href) ? "page" : undefined}
                data-navlink
                class:list={[
                  "text-3xl text-zinc-950/85 aria-[current=page]:font-semibold aria-[current=page]:text-orange sm:text-4xl md:text-5xl",
                  activeLinkMarker,
                ]}
                rollClass="text-orange"
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Footer: tagline + contact + socials -->
    <div
      class="flex w-full flex-col items-center gap-3 border-t border-zinc-950/10 pt-6 pb-[max(2rem,env(safe-area-inset-bottom))]"
    >
      <p class="max-w-md text-center text-sm text-zinc-600">
        {brand.tagline}
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="text-sm text-zinc-600 underline-offset-2 hover:text-zinc-950 hover:underline"
      >
        {SITE.email}
      </a>
      <div class="flex items-center gap-4">
        {
          SITE.social.facebook && (
            <a
              href={SITE.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="text-zinc-600 transition hover:text-orange"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-6 w-6 fill-current"
                aria-hidden="true"
              >
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.43-4.92 8.43-9.94Z" />
              </svg>
            </a>
          )
        }
        {
          SITE.social.instagram && (
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="text-zinc-600 transition hover:text-orange"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-6 w-6 fill-current"
                aria-hidden="true"
              >
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2 12 2s3.58.01 4.85.07Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4.16 4.16 0 1 1 0-8.32 4.16 4.16 0 0 1 0 8.32Zm6.41-10.4a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" />
              </svg>
            </a>
          )
        }
        {
          SITE.social.youtube && (
            <a
              href={SITE.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="text-zinc-600 transition hover:text-orange"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-6 w-6 fill-current"
                aria-hidden="true"
              >
                <path d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.58A3 3 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3 3 0 0 0 2.12 2.12C4.5 20.5 12 20.5 12 20.5s7.5 0 9.38-.58a3 3 0 0 0 2.12-2.12c.5-1.87.5-5.8.5-5.8s0-3.93-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  /* Navbar color modes. Solid (default): zinc-50 bar, dark ink. Overlay
     (over the home hero): transparent bar, light ink. Components read the
     --nav-fg* variables so the whole flip lives in one place. */
  header {
    --nav-fg: var(--color-zinc-950);
    --nav-fg-muted: rgb(9 9 11 / 0.6);
    --nav-fg-faint: rgb(9 9 11 / 0.3);
    color: var(--nav-fg);
    transition: background-color 0.3s ease;
  }
  header[data-mode='overlay'] {
    --nav-fg: var(--color-zinc-50);
    --nav-fg-muted: rgb(250 250 250 / 0.6);
    --nav-fg-faint: rgb(250 250 250 / 0.3);
    background-color: transparent;
  }
  /* The fullscreen menu panel is zinc-50: force the solid look while it is
     open, whatever the scroll position. */
  #nav-menu[data-open='true'] header {
    --nav-fg: var(--color-zinc-950);
    --nav-fg-muted: rgb(9 9 11 / 0.6);
    --nav-fg-faint: rgb(9 9 11 / 0.3);
    background-color: var(--color-zinc-50);
  }

  /* Brand logo: dark variant on the solid bar, white knockout over the
     hero. Exactly one is displayed at a time (same box, no layout shift). */
  .logo-light {
    display: none;
  }
  header[data-mode='overlay'] .logo-dark {
    display: none;
  }
  header[data-mode='overlay'] .logo-light {
    display: block;
  }
  #nav-menu[data-open='true'] .logo-dark {
    display: block;
  }
  #nav-menu[data-open='true'] .logo-light {
    display: none;
  }

  /* Hamburger lines */
  .bar {
    position: absolute;
    left: 0.25rem;
    height: 0.125rem;
    width: 2.5rem;
    background-color: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }
  .bar1,
  .bar2 {
    top: 50%;
  }
  .bar1 {
    transform: translateY(calc(-50% - 7px));
  }
  .bar2 {
    transform: translateY(calc(-50% + 7px));
  }

  /* Open: rotate both to center -> X */
  :global(#nav-menu[data-open="true"]) .bar1 {
    transform: translateY(-50%) rotate(45deg);
  }
  :global(#nav-menu[data-open="true"]) .bar2 {
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Overlay hidden by default. `visibility` is delayed on close so the
     opacity fade finishes before the element leaves the hit/focus order. */
  .overlay {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  :global(#nav-menu[data-open="true"]) .overlay {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .overlay,
    header {
      transition: none;
    }
  }
</style>

<script>
  // State lives on #nav-menu (data-open). Element-level listeners die with
  // the DOM node on ClientRouter swaps; the astro:page-load listener is
  // registered once per document and always queries the live DOM, so no
  // stale closures survive navigations.
  function parts(root: HTMLElement) {
    return {
      toggle: root.querySelector<HTMLButtonElement>("#nav-toggle"),
      overlay: root.querySelector<HTMLElement>("#nav-overlay"),
    };
  }

  function setOpen(root: HTMLElement, open: boolean) {
    const { toggle, overlay } = parts(root);
    if (!toggle || !overlay) return;

    root.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open
        ? (toggle.dataset.labelClose ?? "")
        : (toggle.dataset.labelOpen ?? ""),
    );
    overlay.inert = !open;

    // Scroll lock + compensate for the disappearing scrollbar.
    document.documentElement.style.overflow = open ? "hidden" : "";
    document.documentElement.style.paddingRight = open
      ? `${window.innerWidth - document.documentElement.clientWidth}px`
      : "";

    if (open) {
      overlay.querySelector<HTMLElement>("[data-navlink]")?.focus();
    } else if (overlay.contains(document.activeElement)) {
      toggle.focus();
    }
  }

  function setup(root: HTMLElement) {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const { toggle, overlay } = parts(root);
    if (!toggle || !overlay) return;

    toggle.addEventListener("click", () =>
      setOpen(root, root.dataset.open !== "true"),
    );
    // Close after navigating via a link.
    overlay
      .querySelectorAll("[data-navlink]")
      .forEach((a) => a.addEventListener("click", () => setOpen(root, false)));

    root.addEventListener("keydown", (e) => {
      if (root.dataset.open !== "true") return;
      if (e.key === "Escape") {
        setOpen(root, false);
        return;
      }
      // Focus trap: cycle Tab through [toggle, ...overlay focusables].
      if (e.key !== "Tab") return;
      const focusables = [
        toggle,
        ...overlay.querySelectorAll<HTMLElement>("a[href], button"),
      ];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  // Navbar mode: overlay (transparent, light ink) while the home hero is
  // still under the bar; solid (zinc-50, dark ink) once it exits. Pages
  // declare a hero with [data-hero]; the flip point is the hero's bottom
  // edge minus the bar height, so the transition lands exactly as the
  // photo leaves.
  function updateMode() {
    const header = document.querySelector<HTMLElement>("#nav-menu > header");
    if (!header) return;
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    let mode = "solid";
    if (hero && window.scrollY < hero.offsetHeight - header.offsetHeight) {
      mode = "overlay";
    }
    if (header.dataset.mode !== mode) header.dataset.mode = mode;
  }

  function bind() {
    const root = document.getElementById("nav-menu");
    if (root) setup(root);
    updateMode();
  }

  bind();
  if (!(window as any).__navGlobalBound) {
    (window as any).__navGlobalBound = true;
    document.addEventListener("astro:page-load", bind);
    window.addEventListener("scroll", updateMode, { passive: true });
    window.addEventListener("resize", updateMode, { passive: true });
    // Close if the viewport grows to desktop while the menu is open.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (!e.matches) return;
      const root = document.getElementById("nav-menu");
      if (root?.dataset.open === "true") setOpen(root, false);
    });
  }
</script>
