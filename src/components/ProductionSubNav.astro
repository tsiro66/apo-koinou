---
// Sticky section menu for the production detail page. Sits in flow
// right under the hero and sticks below the navbar (top-14 = the bar's
// 3.5rem) once scrolled to — the persistent version of the old hero
// chip row: one horizontally scrolling row that never wraps on mobile
// and stays available for the whole page. Pure CSS stickiness, no JS
// and no scroll listeners (the Navbar owns the data-hero contract for
// its own solid/transparent flip). Sections carry scroll-mt-28
// (7rem = navbar 3.5rem + this bar's 3.5rem) so anchors clear both bars.
import type { HeaderButton } from "./ProductionHero.astro";

interface Props {
  buttons: HeaderButton[];
  /** Accessible name for the nav (the production title). */
  label: string;
}
const { buttons, label } = Astro.props;
---

<nav
  aria-label={label}
  class="-mx-4 sticky top-14 z-30 border-b border-zinc-950/10 bg-zinc-950/95 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-6xl items-center gap-2 overflow-x-auto px-4 py-1.5 [scrollbar-width:none] sm:px-6 [&::-webkit-scrollbar]:hidden"
  >
    {
      buttons.map((b) => (
        <a
          href={b.href}
          class="inline-flex h-11 shrink-0 touch-manipulation items-center whitespace-nowrap border border-zinc-50/40 px-3 text-xs font-semibold text-zinc-50 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950"
        >
          {b.label}
          {b.count !== undefined && b.count > 1 && (
            <span
              aria-hidden="true"
              class="ml-1.5 font-normal text-zinc-50/60 group-hover:text-zinc-950/50"
            >
              {b.count}
            </span>
          )}
        </a>
      ))
    }
  </div>
</nav>
