---
// Embeds a Bunny Stream video. The video ID lives only in frontmatter,
// never hardcoded in pages. Uses the official iframe embed.
import { BUNNY_LIBRARY_ID } from '../consts';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  videoId: string;
  title?: string;
}
const { videoId, title } = Astro.props;
const videoTitle = title ?? useTranslations(getLocaleFromUrl(Astro.url))('prod.stream_default');
// Bunny Stream iframe syntax:
// https://iframe.mediadelivery.net/embed/<libraryId>/<videoId>
// The library ID is site-wide (consts.ts); videoId is the per-video GUID.
const src = `https://iframe.mediadelivery.net/embed/${BUNNY_LIBRARY_ID}/${videoId}`;
---

<div class="overflow-hidden rounded-lg border border-zinc-950/10 bg-zinc-950 shadow-md">
  <iframe
    src={src}
    title={videoTitle}
    allow="accelerometer; gyroscope; encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
    class="aspect-video w-full"
    loading="lazy"
  ></iframe>
</div>
