---
// One page per production: the play (Θεατρικό έργο, συντελεστές, διανομή,
// τόπος & χρόνος), the recording (Παράσταση, with the trailer as a
// click-to-load card inside it) and all Υλικό sections (φωτογραφίες,
// έντυπο υλικό = αφίσα + πρόσκληση + πρόγραμμα merged, κριτικές) — the old
// separate /yliko page is merged in so nothing sits behind a cross-page
// link. The menu is the sticky chip bar under the hero: every section on
// the page, one row, always reachable.
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import ProductionHero from "../components/ProductionHero.astro";
import ProductionSubNav from "../components/ProductionSubNav.astro";
import ProductionSection from "../components/ProductionSection.astro";
import ProductionFacts from "../components/ProductionFacts.astro";
import TrailerFacade from "../components/TrailerFacade.astro";
import InterviewAudio from "../components/InterviewAudio.astro";
import Gallery from "../components/Gallery.astro";
import Lightbox from "../components/Lightbox.astro";
import Reviews from "../components/Reviews.astro";
import { BRAND } from "../consts";
import { getLocaleFromUrl, useTranslations, formatDate } from "../i18n/utils";
import {
  getThumbnail,
  getPhotos,
  getVideoId,
  lightboxSrc,
  ogSrc,
  toYouTubeId,
} from "../utils/media";
import { formatShowDate, sortShows } from "../utils/repertoire";

interface Props {
  play: CollectionEntry<"parastaseis">;
}
const { play } = Astro.props;
const { Content } = await render(play);
const d = play.data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];

// Placeholder Bunny IDs ("TODO") must not render a broken video player.
const videoId = getVideoId(d);

// YouTube trailer: accept a bare ID or a full watch/youtu.be URL.
const youtubeId = d.youtubeTrailer ? toYouTubeId(d.youtubeTrailer) : undefined;

// Lightbox full views: optimized build-time WebP (see lightboxSrc).
const invitationItems = await Promise.all(
  d.invitation.map(async (src) => ({ src, full: await lightboxSrc(src) })),
);
const programItems = await Promise.all(
  d.program.map(async (src) => ({ src, full: await lightboxSrc(src) })),
);
const posterFull = d.poster ? await lightboxSrc(d.poster) : undefined;

// Section visibility: render a section (and its chip) only when it has data.
const photos = getPhotos(d);
const hasCrew = d.crew.length > 0;
const hasCast = d.cast.length > 0;
const hasPlaceTime = d.performances.length > 0 || !!d.premiereDate;
const hasPhotos = photos.length > 0;
const hasInvitation = d.invitation.length > 0;
const hasProgram = d.program.length > 0;
const hasPoster = !!d.poster;
const hasReviews = d.kritikes.length > 0;
// Printed material (Αφίσα, Πρόσκληση, Πρόγραμμα): same content type —
// scanned paper — so the three old sections share one band.
const hasPrinted = hasInvitation || hasProgram || hasPoster;
const printedCount =
  d.invitation.length + d.program.length + (hasPoster ? 1 : 0);
const hasInterviews =
  d.syneunteixeisVideo.length > 0 || d.syneunteixeisAudio.length > 0;

// Menu below the hero title: every section on the page, in render order —
// the single navigation system. "Παράσταση" gets no chip: the orange
// Watch now button already targets the stream.
const buttons = [
  { href: "#theatriko-ergo", label: t("prod.section.play") },
  ...(hasCrew ? [{ href: "#syntelestes", label: t("prod.crew_section") }] : []),
  ...(hasCast ? [{ href: "#dianomi", label: t("prod.section.cast") }] : []),
  ...(hasPlaceTime
    ? [{ href: "#topos-chronos", label: t("prod.section.place_time") }]
    : []),
  // Trailer chip: standalone section when there's no recording, otherwise
  // the embedded teaser inside Παράσταση carries the #treiler anchor.
  ...(youtubeId
    ? [{ href: "#treiler", label: t("prod.trailer_section") }]
    : []),
  ...(hasPhotos
    ? [
        {
          href: "#fotografies",
          label: t("prod.gallery_section"),
          count: photos.length,
        },
      ]
    : []),
  ...(hasPrinted
    ? [
        {
          href: "#entypo-yliko",
          label: t("prod.printed_material"),
          count: printedCount,
        },
      ]
    : []),
  ...(hasInterviews
    ? [{ href: "#syneunteixeis", label: t("prod.interviews") }]
    : []),
  ...(hasReviews
    ? [
        {
          href: "#kritikes",
          label: t("prod.reviews"),
          count: d.kritikes.length,
        },
      ]
    : []),
];

// Alternating full-bleed bands, in render order.
const orderedSections = [
  "theatriko-ergo",
  ...(hasCrew ? ["syntelestes"] : []),
  ...(hasCast ? ["dianomi"] : []),
  ...(hasPlaceTime ? ["topos-chronos"] : []),
  // The recording comes before the trailer teaser: the stream is the
  // page's product. A trailer without a recording stays a standalone
  // section; otherwise it lives inside Παράσταση.
  ...(videoId ? ["parastasi"] : []),
  ...(!videoId && youtubeId ? ["treiler"] : []),
  ...(hasPhotos ? ["fotografies"] : []),
  ...(hasPrinted ? ["entypo-yliko"] : []),
  ...(hasInterviews ? ["syneunteixeis"] : []),
  ...(hasReviews ? ["kritikes"] : []),
];
const band = (id: string) => orderedSections.indexOf(id) % 2 === 0;

// og:image: optimized 1200×630 JPEG, never the raw original.
const ogImg = d.seoImage ?? getThumbnail(d);
const og = ogImg ? await ogSrc(ogImg) : undefined;

const playFacts = [
  { label: t("prod.field.title"), value: d.title },
  ...(d.writer ? [{ label: t("prod.writer"), value: d.writer }] : []),
];

const placeTimeFacts =
  d.performances.length > 0
    ? sortShows(d.performances).map((p) => ({
        label: formatShowDate(p, locale),
        value: p.venue,
      }))
    : d.premiereDate
      ? [
          {
            label: t("prod.premiere"),
            value: formatDate(d.premiereDate, locale),
          },
        ]
      : [];
---

<BaseLayout
  title={d.title}
  description={d.seoDescription ?? d.summary ?? brand.description}
  image={og?.src}
  imageWidth={og?.width}
  imageHeight={og?.height}
  canonicalPath={`/parastaseis/${play.id}`}
  type="article"
  flush
>
  <article>
    <ProductionHero
      title={d.title}
      year={d.year}
      thumb={getThumbnail(d)}
      watchNowHref={videoId ? "#parastasi" : undefined}
    />

    {
      /* Sticky section menu — replaces the old hero chip row: same links,
        one horizontally scrolling row, reachable for the whole page. */
    }
    <ProductionSubNav buttons={buttons} label={d.title} />

    <Lightbox />

    <div class="mt-6">
      <ProductionSection
        id="theatriko-ergo"
        title={t("prod.section.play")}
        band={band("theatriko-ergo")}
      >
        <ProductionFacts facts={playFacts} />
        {
          d.summary && (
            <p class="mt-6 leading-relaxed text-zinc-950/80">{d.summary}</p>
          )
        }
        {
          play.body?.trim() && (
            <div class="prose mt-6 max-w-none">
              <Content />
            </div>
          )
        }
      </ProductionSection>

      {
        hasCrew && (
          <ProductionSection
            id="syntelestes"
            title={t("prod.crew_section")}
            band={band("syntelestes")}
          >
            <ProductionFacts
              facts={d.crew.map((c) => ({ label: c.role, value: c.name }))}
            />
          </ProductionSection>
        )
      }

      {
        hasCast && (
          <ProductionSection
            id="dianomi"
            title={t("prod.section.cast")}
            band={band("dianomi")}
          >
            <ProductionFacts
              facts={d.cast.map((c) => ({
                label: c.role ?? "",
                value: c.name,
              }))}
            />
          </ProductionSection>
        )
      }

      {
        hasPlaceTime && (
          <ProductionSection
            id="topos-chronos"
            title={t("prod.section.place_time")}
            band={band("topos-chronos")}
          >
            <ProductionFacts facts={placeTimeFacts} />
          </ProductionSection>
        )
      }

      {
        !videoId && youtubeId && (
          <ProductionSection
            id="treiler"
            title={t("prod.trailer_section")}
            band={band("treiler")}
          >
            <TrailerFacade
              youtubeId={youtubeId}
              title={`${t("prod.trailer_section")} — ${d.title}`}
            />
          </ProductionSection>
        )
      }

      {
        videoId && (
          <ProductionSection
            id="parastasi"
            title={t("prod.stream_section")}
            band={band("parastasi")}
          >
            <StreamPlayer videoId={videoId} title={d.title} />
            {youtubeId && (
              <div id="treiler" class="mt-8 scroll-mt-28">
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.trailer_section")}
                </h3>
                <div class="mt-3 max-w-xl">
                  <TrailerFacade
                    youtubeId={youtubeId}
                    title={`${t("prod.trailer_section")} — ${d.title}`}
                  />
                </div>
              </div>
            )}
          </ProductionSection>
        )
      }

      {
        hasPhotos && (
          <ProductionSection
            id="fotografies"
            title={t("prod.gallery_section")}
            count={photos.length}
            band={band("fotografies")}
          >
            <Gallery
              images={photos}
              alt={d.title}
              group={`${play.id}-fotografies`}
            />
          </ProductionSection>
        )
      }

      {
        /* Έντυπο υλικό: αφίσα, πρόσκληση, πρόγραμμα — all scanned paper,
           so one section (poster first, then the document grids) instead
           of three near-identical bands. */
        hasPrinted && (
          <ProductionSection
            id="entypo-yliko"
            title={t("prod.printed_material")}
            count={printedCount}
            band={band("entypo-yliko")}
          >
            {hasPoster && d.poster && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.poster")}
                </h3>
                <button
                  type="button"
                  data-lightbox={`${play.id}-afisa`}
                  data-lightbox-src={posterFull}
                  aria-label={`${d.title} — ${t("prod.poster")}`}
                  class="mt-3 block max-w-md cursor-zoom-in overflow-hidden border border-zinc-950/10"
                >
                  <Image
                    src={d.poster}
                    alt={`${d.title} — ${t("prod.poster")}`}
                    widths={[480, 768]}
                    sizes="(min-width:640px) 448px, 100vw"
                    width={768}
                    class="h-auto w-full"
                  />
                </button>
              </div>
            )}

            {hasInvitation && (
              <div class:list={[hasPoster && "mt-8"]}>
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.invitation")}
                </h3>
                <ul class="mt-3 grid gap-4 sm:grid-cols-2">
                  {invitationItems.map(({ src, full }, i) => (
                    <li>
                      <button
                        type="button"
                        data-lightbox={`${play.id}-prosklisi`}
                        data-lightbox-src={full}
                        aria-label={`${d.title} — ${t("prod.invitation")} ${i + 1}`}
                        class="block w-full cursor-zoom-in overflow-hidden border border-zinc-950/10"
                      >
                        <Image
                          src={src}
                          alt={`${d.title} — ${t("prod.invitation")} ${i + 1}`}
                          widths={[480, 720]}
                          sizes="(min-width:640px) 50vw, 100vw"
                          width={720}
                          class="h-auto w-full"
                        />
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {hasProgram && (
              <div class:list={[(hasPoster || hasInvitation) && "mt-8"]}>
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.program")}
                </h3>
                <ul class="mt-3 grid gap-4 sm:grid-cols-2">
                  {programItems.map(({ src, full }, i) => (
                    <li>
                      <button
                        type="button"
                        data-lightbox={`${play.id}-programma`}
                        data-lightbox-src={full}
                        aria-label={`${d.title} — ${t("prod.program")} ${i + 1}`}
                        class="block w-full cursor-zoom-in overflow-hidden border border-zinc-950/10"
                      >
                        <Image
                          src={src}
                          alt={`${d.title} — ${t("prod.program")} ${i + 1}`}
                          widths={[480, 720]}
                          sizes="(min-width:640px) 50vw, 100vw"
                          width={720}
                          class="h-auto w-full"
                        />
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </ProductionSection>
        )
      }

      {
        /* Συνεντεύξεις: YouTube videos via the click-to-load facade,
           voice recordings via the native <audio> player. */
        hasInterviews && (
          <ProductionSection
            id="syneunteixeis"
            title={t("prod.interviews")}
            band={band("syneunteixeis")}
          >
            {d.syneunteixeisVideo.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.interviews_video")}
                </h3>
                <div class="mt-3 max-w-3xl space-y-6">
                  {d.syneunteixeisVideo.map((v) => (
                    <div>
                      {v.title && (
                        <p class="mb-3 text-sm font-semibold text-zinc-950">
                          {v.title}
                          {v.date && (
                            <span class="ml-2 font-normal text-zinc-950/50">
                              {v.date}
                            </span>
                          )}
                        </p>
                      )}
                      <TrailerFacade
                        youtubeId={toYouTubeId(v.youtube)}
                        title={`${v.title ?? t("prod.interviews")} — ${d.title}`}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

            {d.syneunteixeisAudio.length > 0 && (
              <div class:list={[d.syneunteixeisVideo.length > 0 && "mt-8"]}>
                <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-950/60">
                  {t("prod.interviews_audio")}
                </h3>
                <div class="mt-3 max-w-xl space-y-4">
                  {d.syneunteixeisAudio.map((a) => (
                    <InterviewAudio
                      src={a.audio}
                      title={a.title}
                      date={a.date}
                    />
                  ))}
                </div>
              </div>
            )}
          </ProductionSection>
        )
      }

      {
        hasReviews && (
          <ProductionSection
            id="kritikes"
            title={t("prod.reviews")}
            count={d.kritikes.length}
            band={band("kritikes")}
          >
            <Reviews reviews={d.kritikes} />
          </ProductionSection>
        )
      }
    </div>
  </article>
</BaseLayout>
