---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StreamPlayer from '../components/StreamPlayer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductionHeader from '../components/ProductionHeader.astro';
import ProductionSection from '../components/ProductionSection.astro';
import ProductionFacts from '../components/ProductionFacts.astro';
import { BRAND } from '../consts';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/utils';

interface Props {
  play: CollectionEntry<'parastaseis'>;
}
const { play } = Astro.props;
const { Content } = await render(play);
const d = play.data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];
const canonicalPath = `/parastaseis/${play.id}`;
const ylikoPath = localizedPath(`${canonicalPath}/yliko`, locale);

const formatDate = (date: Date) =>
  date.toLocaleDateString(locale === 'en' ? 'en-GB' : 'el-GR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

// Section visibility: render a section (and its button) only when it has data.
const hasCrew = d.crew.length > 0;
const hasCast = d.cast.length > 0;
const hasPlaceTime = d.performances.length > 0 || !!d.premiereDate;

const buttons = [
  { href: '#theatriko-ergo', label: t('prod.section.play') },
  ...(hasCrew ? [{ href: '#syntelestes', label: t('prod.crew_section') }] : []),
  ...(hasCast ? [{ href: '#dianomi', label: t('prod.section.cast') }] : []),
  ...(hasPlaceTime ? [{ href: '#topos-chronos', label: t('prod.section.place_time') }] : []),
];

// Top-right stats menu: one entry per available Υλικό subsection.
const stats = [
  ...(d.gallery.length > 0
    ? [{ href: `${ylikoPath}#fotografies`, label: t('prod.gallery_section'), count: d.gallery.length }]
    : []),
  ...(d.youtubeTrailer
    ? [{ href: `${ylikoPath}#treiler`, label: t('prod.trailer_section'), count: 1 }]
    : []),
  ...(d.program.length > 0
    ? [{ href: `${ylikoPath}#programma`, label: t('prod.program'), count: d.program.length }]
    : []),
  ...(d.poster ? [{ href: `${ylikoPath}#afisa`, label: t('prod.poster'), count: 1 }] : []),
];

// Alternating full-bleed bands, in render order.
const orderedSections = [
  'theatriko-ergo',
  ...(hasCrew ? ['syntelestes'] : []),
  ...(hasCast ? ['dianomi'] : []),
  ...(hasPlaceTime ? ['topos-chronos'] : []),
  ...(d.streamId ? ['parastasi'] : []),
];
const band = (id: string) => orderedSections.indexOf(id) % 2 === 0;

const playFacts = [
  { label: t('prod.field.title'), value: d.title },
  ...(d.writer ? [{ label: t('prod.writer'), value: d.writer }] : []),
];

const placeTimeFacts = d.performances.length > 0
  ? d.performances.map((p) => ({ label: formatDate(p.date), value: p.venue }))
  : d.premiereDate
    ? [{ label: t('prod.premiere'), value: formatDate(d.premiereDate) }]
    : [];
---

<BaseLayout
  title={d.title}
  description={d.seoDescription ?? d.summary ?? brand.description}
  image={(d.seoImage ?? d.thumbnail)?.src}
  canonicalPath={canonicalPath}
  type="article"
>
  <article>
    <div class="mx-auto max-w-6xl">
      <Breadcrumbs
        crumbs={[
          { label: t('nav.home'), href: localizedPath('/', locale) },
          { label: t('page.parastaseis.title'), href: localizedPath('/parastaseis', locale) },
          { label: d.title },
        ]}
      />
      <ProductionHeader
        play={play}
        buttons={buttons}
        stats={stats}
        watchNowHref={d.streamId ? '#parastasi' : undefined}
      />
    </div>

    <div class="mt-10">
      <ProductionSection id="theatriko-ergo" title={t('prod.section.play')} band={band('theatriko-ergo')}>
        <ProductionFacts facts={playFacts} />
        {d.summary && <p class="mt-6 leading-relaxed text-zinc-950/80">{d.summary}</p>}
        {
          play.body?.trim() && (
            <div class="prose mt-6 max-w-none">
              <Content />
            </div>
          )
        }
      </ProductionSection>

      {
        hasCrew && (
          <ProductionSection id="syntelestes" title={t('prod.crew_section')} band={band('syntelestes')}>
            <ProductionFacts facts={d.crew.map((c) => ({ label: c.role, value: c.name }))} />
          </ProductionSection>
        )
      }

      {
        hasCast && (
          <ProductionSection id="dianomi" title={t('prod.section.cast')} band={band('dianomi')}>
            <ProductionFacts
              facts={d.cast.map((c) => ({ label: c.role ?? '', value: c.name }))}
            />
          </ProductionSection>
        )
      }

      {
        hasPlaceTime && (
          <ProductionSection id="topos-chronos" title={t('prod.section.place_time')} band={band('topos-chronos')}>
            <ProductionFacts facts={placeTimeFacts} />
          </ProductionSection>
        )
      }

      {
        d.streamId && (
          <ProductionSection id="parastasi" title={t('prod.stream_section')} band={band('parastasi')}>
            <StreamPlayer streamId={d.streamId} title={d.title} />
          </ProductionSection>
        )
      }
    </div>
  </article>
</BaseLayout>
