---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RepertoireFeature from "../components/RepertoireFeature.astro";
import { SEASON } from "../consts";
import { getRepertoire } from "../utils/repertoire";
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
  format,
} from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Plays picked for the current season (Ρεπερτόριο collection in Pages CMS),
// ordered by the entry's `order` field, then newest play first.
const items = await getRepertoire();
const heading = format(t("page.repertorio.heading"), { season: SEASON });
---

<BaseLayout title={t("page.repertorio.title")} canonicalPath="/repertorio">
  <div class="mx-auto max-w-6xl">
    <Breadcrumbs
      crumbs={[
        { label: t("nav.home"), href: localizedPath("/", locale) },
        { label: t("page.repertorio.title") },
      ]}
    />
    <div class="mt-6">
      <SectionTitle eyebrow={t("page.repertorio.eyebrow")} title={heading} />
    </div>
    {
      items.length > 0 ? (
        // Full-width featured blocks — one per play, photo side alternating.
        <div class="mt-10 flex flex-col gap-16 sm:gap-20">
          {items.map((entry, index) => (
            <RepertoireFeature entry={entry} index={index} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-zinc-600">{t("page.repertorio.soon")}</p>
      )
    }
  </div>
</BaseLayout>
