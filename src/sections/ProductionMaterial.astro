---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Gallery from '../components/Gallery.astro';
import ProductionHeader from '../components/ProductionHeader.astro';
import ProductionSection from '../components/ProductionSection.astro';
import Reviews from '../components/Reviews.astro';
import { BRAND } from '../consts';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { getThumbnail, getPhotos } from '../utils/media';

interface Props {
  play: CollectionEntry<'parastaseis'>;
}
const { play } = Astro.props;
const d = play.data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];
const playPath = `/parastaseis/${play.id}`;
const canonicalPath = `${playPath}/yliko`;

const youtubeId = d.youtubeTrailer?.startsWith('http')
  ? d.youtubeTrailer.split('v=')[1]?.split('&')[0]
  : d.youtubeTrailer;

// Section visibility: render a section (and its button) only when it has data.
const photos = getPhotos(d);
const hasPhotos = photos.length > 0;
const hasTrailer = !!youtubeId;
const hasProgram = d.program.length > 0;
const hasInvitation = d.invitation.length > 0;
const hasPoster = !!d.poster;
const hasReviews = d.kritikes.length > 0;

const buttons = [
  ...(hasPhotos ? [{ href: '#fotografies', label: t('prod.gallery_section') }] : []),
  ...(hasTrailer ? [{ href: '#treiler', label: t('prod.trailer_section') }] : []),
  ...(hasInvitation ? [{ href: '#prosklisi', label: t('prod.invitation') }] : []),
  ...(hasProgram ? [{ href: '#programma', label: t('prod.program') }] : []),
  ...(hasPoster ? [{ href: '#afisa', label: t('prod.poster') }] : []),
  ...(hasReviews ? [{ href: '#kritikes', label: t('prod.reviews') }] : []),
];

// Alternating full-bleed bands, in render order.
const orderedSections = [
  ...(hasPhotos ? ['fotografies'] : []),
  ...(hasTrailer ? ['treiler'] : []),
  ...(hasInvitation ? ['prosklisi'] : []),
  ...(hasProgram ? ['programma'] : []),
  ...(hasPoster ? ['afisa'] : []),
  ...(hasReviews ? ['kritikes'] : []),
];
const band = (id: string) => orderedSections.indexOf(id) % 2 === 0;
---

<BaseLayout
  title={`${d.title} — ${t('prod.yliko')}`}
  description={d.seoDescription ?? d.summary ?? brand.description}
  image={(d.seoImage ?? getThumbnail(d))?.src}
  canonicalPath={canonicalPath}
  type="article"
>
  <article>
    <div class="mx-auto max-w-6xl">
      <Breadcrumbs
        crumbs={[
          { label: t('nav.home'), href: localizedPath('/', locale) },
          { label: t('page.parastaseis.title'), href: localizedPath('/parastaseis', locale) },
          { label: d.title, href: localizedPath(playPath, locale) },
          { label: t('prod.yliko') },
        ]}
      />
      <a
        href={localizedPath(playPath, locale)}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-zinc-600 transition hover:text-orange"
      >
        <span aria-hidden="true">←</span>
        {t('prod.back_to_play')}
      </a>
      <ProductionHeader play={play} buttons={buttons} />
    </div>

    <div class="mt-10">
      {
        hasPhotos && (
          <ProductionSection
            id="fotografies"
            title={t('prod.gallery_section')}
            count={photos.length}
            band={band('fotografies')}
          >
            <Gallery images={photos} alt={d.title} />
          </ProductionSection>
        )
      }

      {
        hasTrailer && (
          <ProductionSection id="treiler" title={t('prod.trailer_section')} band={band('treiler')}>
            <div class="overflow-hidden border border-zinc-950/10 bg-zinc-950 shadow-md">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
                title={`${t('prod.trailer_section')} — ${d.title}`}
                allow="accelerometer; encrypted-media; fullscreen"
                allowfullscreen
                class="aspect-video w-full"
                loading="lazy"></iframe>
            </div>
          </ProductionSection>
        )
      }

      {
        hasInvitation && (
          <ProductionSection
            id="prosklisi"
            title={t('prod.invitation')}
            count={d.invitation.length}
            band={band('prosklisi')}
          >
            <ul class="grid gap-4 sm:grid-cols-2">
              {d.invitation.map((src, i) => (
                <li>
                  <a
                    href={src.src}
                    target="_blank"
                    class="block overflow-hidden border border-zinc-950/10"
                  >
                    <Image
                      src={src}
                      alt={`${d.title} — ${t('prod.invitation')} ${i + 1}`}
                      widths={[480, 720]}
                      sizes="(min-width:640px) 50vw, 100vw"
                      width={720}
                      class="h-auto w-full"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </ProductionSection>
        )
      }

      {
        hasProgram && (
          <ProductionSection
            id="programma"
            title={t('prod.program')}
            count={d.program.length}
            band={band('programma')}
          >
            <ul class="grid gap-4 sm:grid-cols-2">
              {d.program.map((src, i) => (
                <li>
                  <a
                    href={src.src}
                    target="_blank"
                    class="block overflow-hidden border border-zinc-950/10"
                  >
                    <Image
                      src={src}
                      alt={`${d.title} — ${t('prod.program')} ${i + 1}`}
                      widths={[480, 720]}
                      sizes="(min-width:640px) 50vw, 100vw"
                      width={720}
                      class="h-auto w-full"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </ProductionSection>
        )
      }

      {
        hasPoster && d.poster && (
          <ProductionSection id="afisa" title={t('prod.poster')} band={band('afisa')}>
            <a
              href={d.poster.src}
              target="_blank"
              class="block max-w-md overflow-hidden border border-zinc-950/10"
            >
              <Image
                src={d.poster}
                alt={`${d.title} — ${t('prod.poster')}`}
                widths={[480, 768]}
                sizes="(min-width:640px) 448px, 100vw"
                width={768}
                class="h-auto w-full"
              />
            </a>
          </ProductionSection>
        )
      }

      {
        hasReviews && (
          <ProductionSection
            id="kritikes"
            title={t('prod.reviews')}
            count={d.kritikes.length}
            band={band('kritikes')}
          >
            <Reviews reviews={d.kritikes} />
          </ProductionSection>
        )
      }
    </div>
  </article>
</BaseLayout>
