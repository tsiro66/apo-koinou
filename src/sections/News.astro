---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const posts = (await getCollection('nea')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString(locale === 'en' ? 'en-GB' : 'el-GR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout title={t('page.nea.title')} canonicalPath="/nea">
  <div class="mx-auto max-w-6xl">
    <Breadcrumbs
      crumbs={[
        { label: t('nav.home'), href: localizedPath('/', locale) },
        { label: t('page.nea.title') },
      ]}
    />
    <div class="mt-6">
      <SectionTitle eyebrow={t('page.nea.eyebrow')} title={t('page.nea.title')} />
    </div>
    {
      posts.length > 0 ? (
        <ul class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <a
                href={localizedPath(`/nea/${post.id}`, locale)}
                class="group block"
              >
                {post.data.thumbnail ? (
                  <div class="overflow-hidden">
                    <Image
                      src={post.data.thumbnail}
                      alt=""
                      widths={[480, 720]}
                      sizes="(min-width:1024px) 33vw,(min-width:640px) 50vw,100vw"
                      width={720}
                      height={378}
                      loading="lazy"
                      class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                    />
                  </div>
                ) : (
                  <div class="flex aspect-video w-full items-center justify-center bg-zinc-950/5 px-4 text-center font-display text-2xl text-zinc-950/40">
                    {post.data.title}
                  </div>
                )}
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-orange">
                  {fmt(post.data.publishDate)}
                </p>
                <h2 class="mt-1 font-display text-2xl leading-snug text-zinc-950 transition group-hover:text-orange">
                  {post.data.title}
                </h2>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 text-zinc-600">{t('empty.nea')}</p>
      )
    }
  </div>
</BaseLayout>
