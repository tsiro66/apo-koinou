---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PlayCard from '../components/PlayCard.astro';
import heroBg from '../assets/bg.jpg';
import { BRAND, SEASON } from '../consts';
import { getThumbnail, getVideoId } from '../utils/media';
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
  format,
} from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];

const parastaseisHref = localizedPath('/parastaseis', locale);
const programmaHref = localizedPath('/programma', locale);
const neaHref = localizedPath('/nea', locale);

// All published productions, newest first (same order as the archive page).
const plays = (await getCollection('parastaseis', ({ data }) => !data.draft))
  .sort((a, b) => b.data.year - a.data.year);

// Hero carousel: productions the editors flagged for the front page
// (carousel: true), newest first, max five. A slide needs a usable photo
// (explicit thumbnail, else first gallery shot), so flagged plays without
// any image are skipped. If no play is flagged, fall back to the five
// most recent productions with a photo — the hero never renders empty.
const withPhoto = plays
  .map((play) => ({ play, thumb: getThumbnail(play.data) }))
  .filter(
    (s): s is { play: (typeof plays)[number]; thumb: ImageMetadata } =>
      !!s.thumb,
  );
const picked = withPhoto.filter((s) => s.play.data.carousel);
const heroSlides = (picked.length > 0 ? picked : withPhoto).slice(0, 5);

// Latest three productions for the featured section.
const featuredPlays = plays.slice(0, 3);

// Three most recent announcements.
const latestNews = (await getCollection('nea'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString(locale === 'en' ? 'en-GB' : 'el-GR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title={t('page.home.title')}
  description={brand.description}
  canonicalPath="/"
  image={heroBg.src}
  flush
>
  <!-- Hero: full-bleed photo carousel of the productions picked for the
       front page (newest first, max five; falls back to the most recent
       productions when none are picked).
       No visible heading: the photography carries the hero, with only the
       current production's name bottom-right. Runs the full viewport
       height; the navbar overlays it in overlay mode and flips to solid
       as the hero exits. The first slide is eager + high fetch priority: it is the
       LCP element. The negative top margin pulls the photos up under the
       transparent navbar (sticky headers occupy flow space). It must
       match the resting bar height exactly: nav py-2 + h-10 = 3.5rem. -->
  <section
    data-hero
    data-carousel
    class="relative -mx-4 -mt-14 flex min-h-svh items-end overflow-hidden bg-zinc-950"
  >
    {
      heroSlides.length > 0 ? (
        // z-0 gives the slides their own stacking context: their z-index
        // juggling stays below the gradients and hero content.
        <div
          class="absolute inset-0 z-0"
          role="region"
          aria-roledescription="carousel"
          aria-label={t('home.hero.carousel_aria')}
        >
          {heroSlides.map(({ play, thumb }, i) => (
            <div
              data-slide
              role="group"
              aria-roledescription="slide"
              aria-label={format(t('home.hero.slide_label'), {
                index: i + 1,
                total: heroSlides.length,
              })}
              aria-hidden={i !== 0}
              class:list={[
                'hero-slide absolute inset-0',
                { 'is-active': i === 0 },
              ]}
            >
              <Image
                src={thumb}
                alt={play.data.title}
                widths={[768, 1280, 1920, 2560]}
                sizes="100vw"
                width={1920}
                height={1280}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
      ) : (
        // No production photos yet: static fallback shot.
        <Image
          src={heroBg}
          alt=""
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          width={1920}
          height={1280}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/35 to-zinc-950/10"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-zinc-950/60 to-transparent"
    >
    </div>
    <!-- The site title stays as a screen-reader h1: the page keeps its
         document outline (and SEO signal) without covering the photos. -->
    <h1 class="sr-only">{t('site.title')}</h1>
    <!-- Carousel chrome: the current production's name (linked to its
         page) plus slide indicators, bottom-right; prev/next arrows sit
         at the screen edges. Hidden entirely when there is nothing to show. -->
    {
      heroSlides.length > 0 && (
        <div class="absolute right-4 bottom-6 z-10 flex max-w-72 flex-col items-end gap-4 text-right sm:right-6 sm:bottom-8 sm:max-w-md">
          <div class="grid w-full justify-items-end">
            {heroSlides.map(({ play }, i) => (
              <div
                data-caption
                aria-hidden={i !== 0}
                class:list={[
                  'hero-caption col-start-1 row-start-1 flex flex-col items-end gap-4 text-right',
                  { 'is-active': i === 0 },
                ]}
              >
                <a
                  href={localizedPath(`/parastaseis/${play.id}`, locale)}
                  tabindex={i === 0 ? undefined : -1}
                  class="font-display text-2xl leading-tight text-balance text-zinc-50 underline-offset-4 hover:underline sm:text-4xl"
                >
                  {play.data.title}
                </a>
                <div class="flex flex-wrap justify-end gap-2">
                  <a
                    href={localizedPath(`/parastaseis/${play.id}`, locale)}
                    tabindex={i === 0 ? undefined : -1}
                    class="border border-zinc-50/50 px-4 py-2.5 text-sm font-semibold text-zinc-50 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950"
                  >
                    {t('home.hero.view_play')}
                  </a>
                  {getVideoId(play.data) && (
                    <a
                      href={`${localizedPath(`/parastaseis/${play.id}`, locale)}#parastasi`}
                      tabindex={i === 0 ? undefined : -1}
                      class="bg-orange px-4 py-2.5 text-sm font-semibold text-zinc-50 transition hover:bg-zinc-100 hover:text-zinc-950"
                    >
                      {t('prod.watch_now')}
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
          {heroSlides.length > 1 && (
            <div
              class="flex gap-2"
              role="group"
              aria-label={t('home.hero.dots_aria')}
            >
              {heroSlides.map(({ play }, i) => (
                <button
                  data-dot
                  type="button"
                  aria-label={format(t('home.hero.dot_aria'), {
                    title: play.data.title,
                  })}
                  aria-current={i === 0 ? 'true' : undefined}
                  class:list={[
                    'h-1 w-6 transition-colors',
                    i === 0 ? 'bg-orange' : 'bg-zinc-50/40 hover:bg-zinc-50/70',
                  ]}
                />
              ))}
            </div>
          )}
        </div>
      )
    }
    {
      heroSlides.length > 1 && (
        <>
          <button
            data-prev
            type="button"
            aria-label={t('home.hero.prev')}
            class="absolute top-1/2 left-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-zinc-50/40 text-zinc-50/80 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:left-6"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              class="h-5 w-5"
            >
              <path
                d="m10 4-4 4 4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            data-next
            type="button"
            aria-label={t('home.hero.next')}
            class="absolute top-1/2 right-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-zinc-50/40 text-zinc-50/80 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:right-6"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              class="h-5 w-5"
            >
              <path
                d="m6 4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </>
      )
    }
  </section>

  {
    featuredPlays.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl sm:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <SectionTitle
            eyebrow={t('home.featured.eyebrow')}
            title={t('home.featured.heading')}
          />
          <a
            href={parastaseisHref}
            class="inline-flex shrink-0 items-center gap-2 pb-1 text-sm font-semibold text-zinc-950 transition hover:text-orange"
          >
            {t('home.featured.all')}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="mt-8 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {featuredPlays.map((play) => (
            <PlayCard play={play} />
          ))}
        </div>
      </section>
    )
  }

  {
    latestNews.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl sm:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <SectionTitle
            eyebrow={t('page.nea.eyebrow')}
            title={t('page.nea.title')}
          />
          <a
            href={neaHref}
            class="inline-flex shrink-0 items-center gap-2 pb-1 text-sm font-semibold text-zinc-950 transition hover:text-orange"
          >
            {t('home.news.all')}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-3">
          {latestNews.map((post) => (
            <li>
              <a
                href={localizedPath(`/nea/${post.id}`, locale)}
                class="group block"
              >
                {post.data.thumbnail ? (
                  <div class="overflow-hidden">
                    <Image
                      src={post.data.thumbnail}
                      alt=""
                      widths={[480, 720]}
                      sizes="(min-width:640px) 33vw, 100vw"
                      width={720}
                      height={405}
                      loading="lazy"
                      class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                    />
                  </div>
                ) : (
                  <div class="flex aspect-video w-full items-center justify-center bg-zinc-950/5 px-4 text-center font-display text-2xl text-zinc-950/40">
                    {post.data.title}
                  </div>
                )}
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-orange">
                  {fmtDate(post.data.publishDate)}
                </p>
                <h3 class="mt-1 font-display text-xl leading-snug text-zinc-950 transition group-hover:text-orange">
                  {post.data.title}
                </h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Programme band: the orange bookend against the dark footer. Its
       negative bottom margin cancels the footer's mt-16 so the two run
       flush together (flush layout has no bottom padding of its own). -->
  <section class="-mx-4 -mb-16 mt-16 bg-orange text-zinc-50 sm:mt-24">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-50/80">
          {t('page.programma.eyebrow')}
        </p>
        <h2 class="mt-2 font-display text-3xl leading-tight sm:text-4xl">
          {format(t('page.programma.heading'), { season: SEASON })}
        </h2>
        <p class="mt-3 max-w-xl text-sm text-zinc-50/80">
          {t('page.programma.soon')}
        </p>
      </div>
      <a
        href={programmaHref}
        class="inline-flex shrink-0 items-center gap-2 self-start border border-zinc-50/50 px-6 py-3 text-sm font-semibold transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:self-auto"
      >
        {t('home.program.cta')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero carousel: cross-fades the production photos on a timer.
  // Module scripts run only once under the ClientRouter, so re-binding
  // happens through astro:page-load (same pattern as the navbar).
  const HERO_INTERVAL_MS = 7000;
  const HERO_FADE_MS = 1000;

  const heroCleanups: Array<() => void> = [];
  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function bindHeroCarousel() {
    document
      .querySelectorAll<HTMLElement>("[data-carousel]")
      .forEach((root) => {
        if (root.dataset.bound) return;
        root.dataset.bound = "true";

        const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
        if (slides.length < 2) return; // Single photo: nothing to rotate.
        const captions = [
          ...root.querySelectorAll<HTMLElement>("[data-caption]"),
        ];
        const dots = [
          ...root.querySelectorAll<HTMLButtonElement>("[data-dot]"),
        ];
        const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]");
        const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]");

        const ac = new AbortController();
        const { signal } = ac;
        let index = 0;
        let timer: number | undefined;

        // Keep captions, indicators and screen-reader visibility on the
        // active slide. Captions cross-fade through the same is-active
        // class as the slides — without toggling it here the first
        // caption would stay visible forever.
        function sync(i: number) {
          slides.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== i)));
          captions.forEach((c, k) => {
            c.classList.toggle("is-active", k === i);
            c.setAttribute("aria-hidden", String(k !== i));
            // Every link inside the caption (name + buttons) follows its
            // focusability, so hidden slides never trap the keyboard.
            c.querySelectorAll("a").forEach((a) => {
              if (k === i) a.removeAttribute("tabindex");
              else a.setAttribute("tabindex", "-1");
            });
          });
          dots.forEach((d, k) => {
            d.classList.toggle("bg-orange", k === i);
            d.classList.toggle("bg-zinc-50/40", k !== i);
            if (k === i) d.setAttribute("aria-current", "true");
            else d.removeAttribute("aria-current");
          });
        }

        // The incoming slide fades in on top while the outgoing one stays
        // fully opaque underneath until the fade completes (no dip to black).
        function show(i: number) {
          const next = (i + slides.length) % slides.length;
          if (next === index) return;
          const prev = slides[index];
          index = next;
          slides.forEach((s) => s.classList.remove("is-under"));
          prev.classList.replace("is-active", "is-under");
          slides[next].classList.add("is-active");
          window.setTimeout(
            () => prev.classList.remove("is-under"),
            HERO_FADE_MS + 50,
          );
          sync(next);
        }

        function pause() {
          window.clearInterval(timer);
          timer = undefined;
        }
        function play() {
          // No autoplay when the OS asks for reduced motion.
          if (timer !== undefined || prefersReducedMotion()) return;
          timer = window.setInterval(() => show(index + 1), HERO_INTERVAL_MS);
        }

        // Autoplay pauses on hover, keyboard focus and hidden tabs.
        root.addEventListener("mouseenter", pause, { signal });
        root.addEventListener("mouseleave", play, { signal });
        root.addEventListener("focusin", pause, { signal });
        root.addEventListener("focusout", play, { signal });
        document.addEventListener(
          "visibilitychange",
          () => (document.hidden ? pause() : play()),
          { signal },
        );
        window
          .matchMedia("(prefers-reduced-motion: reduce)")
          .addEventListener(
            "change",
            () => (prefersReducedMotion() ? pause() : play()),
            { signal },
          );
        // Manual navigation: jump and reset the autoplay timer.
        const go = (i: number) => {
          show(i);
          pause();
          play();
        };
        prevBtn?.addEventListener("click", () => go(index - 1), { signal });
        nextBtn?.addEventListener("click", () => go(index + 1), { signal });
        dots.forEach((dot, k) =>
          dot.addEventListener("click", () => go(k), { signal }),
        );

        play();
        heroCleanups.push(() => {
          ac.abort();
          pause();
        });
      });
  }

  bindHeroCarousel();
  if (!(window as any).__heroCarouselBound) {
    (window as any).__heroCarouselBound = true;
    document.addEventListener("astro:page-load", bindHeroCarousel);
    // Drop the outgoing page's timers and listeners before a swap.
    document.addEventListener("astro:before-swap", () => {
      heroCleanups.forEach((fn) => fn());
      heroCleanups.length = 0;
    });
  }
</script>

<style>
  /* Hero carousel: the incoming slide (.is-active) fades in on top of the
     previous one (.is-under, kept fully opaque) so the photo cross-fades
     without dipping to the dark background. Reduced motion: instant swap. */
  .hero-slide {
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }
  .hero-slide.is-under {
    z-index: 1;
    opacity: 1;
  }
  .hero-slide.is-active {
    z-index: 2;
    opacity: 1;
  }
  /* Captions share one grid cell; only the active one is visible and
     interactive (stacked links must not catch clicks or focus). */
  .hero-caption {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease-in-out;
  }
  .hero-caption.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-caption {
      transition: none;
    }
  }

</style>
