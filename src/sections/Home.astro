---
// The home page is data selection plus composition; every visual block
// lives in its own component under src/components/home/.
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCarousel from "../components/home/HeroCarousel.astro";
import FeaturedPlays from "../components/home/FeaturedPlays.astro";
import LatestNews from "../components/home/LatestNews.astro";
import RepertoireBand from "../components/home/RepertoireBand.astro";
import heroBg from "../assets/bg.jpg";
import { BRAND } from "../consts";
import { getThumbnail, ogSrc } from "../utils/media";
import { getLocaleFromUrl, useTranslations } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];

// All published productions, newest first (same order as the archive page).
const plays = (
  await getCollection("parastaseis", ({ data }) => !data.draft)
).sort((a, b) => b.data.year - a.data.year);

// Hero carousel: productions the editors flagged for the front page
// (carousel: true), newest first, max five. A slide needs a usable photo
// (explicit thumbnail, else first gallery shot), so flagged plays without
// any image are skipped. If no play is flagged, fall back to the five
// most recent productions with a photo — the hero never renders empty.
const withPhoto = plays
  .map((play) => ({ play, thumb: getThumbnail(play.data) }))
  .filter(
    (s): s is { play: (typeof plays)[number]; thumb: ImageMetadata } =>
      !!s.thumb,
  );
const picked = withPhoto.filter((s) => s.play.data.carousel);
const heroSlides = (picked.length > 0 ? picked : withPhoto).slice(0, 5);

// Latest three productions for the featured section.
const featuredPlays = plays.slice(0, 3);

// Three most recent announcements.
const latestNews = (await getCollection("nea"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// og:image: optimized 1200×630 JPEG crop of the hero photo, never the raw original.
const og = await ogSrc(heroBg);
---

<BaseLayout
  title={t("page.home.title")}
  description={brand.description}
  canonicalPath="/"
  image={og.src}
  imageWidth={og.width}
  imageHeight={og.height}
  flush
>
  <HeroCarousel slides={heroSlides} />
  <FeaturedPlays plays={featuredPlays} />
  <LatestNews posts={latestNews} />
  <RepertoireBand />
</BaseLayout>
