---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PlayCard from '../components/PlayCard.astro';
import heroBg from '../assets/bg.jpg';
import { BRAND, SEASON } from '../consts';
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
  format,
} from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const brand = BRAND[locale];

const parastaseisHref = localizedPath('/parastaseis', locale);
const programmaHref = localizedPath('/programma', locale);
const neaHref = localizedPath('/nea', locale);

// Latest three productions (year desc — same order as the archive page).
const featuredPlays = (
  await getCollection('parastaseis', ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

// Three most recent announcements.
const latestNews = (await getCollection('nea'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString(locale === 'en' ? 'en-GB' : 'el-GR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title={t('page.home.title')}
  description={brand.description}
  canonicalPath="/"
  image={heroBg.src}
  flush
>
  <!-- Hero: full-bleed stage photograph, content anchored bottom-left.
       Eager + high fetch priority: this is the LCP element. -->
  <section
    class="relative -mx-4 flex min-h-[clamp(520px,74svh,860px)] items-end overflow-hidden bg-zinc-950"
  >
    <Image
      src={heroBg}
      alt={t('home.hero.alt')}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      width={1920}
      height={1280}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/35 to-zinc-950/10"
    >
    </div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pt-48 pb-16 sm:pb-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange">
        {t('page.home.eyebrow')}
      </p>
      <h1
        class="mt-3 font-display text-5xl leading-[1.05] text-zinc-50 sm:text-6xl lg:text-7xl"
      >
        {t('site.title')}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-zinc-50/85 sm:text-xl">
        {t('site.tagline')}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={parastaseisHref}
          class="bg-orange px-6 py-3 text-sm font-semibold text-zinc-50 transition hover:bg-zinc-100 hover:text-zinc-950"
        >
          {t('nav.parastaseis')}
        </a>
        <a
          href={programmaHref}
          class="border border-zinc-50/50 px-6 py-3 text-sm font-semibold text-zinc-50 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950"
        >
          {t('nav.programma')}
        </a>
      </div>
    </div>
  </section>

  {
    featuredPlays.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl sm:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <SectionTitle
            eyebrow={t('home.featured.eyebrow')}
            title={t('home.featured.heading')}
          />
          <a
            href={parastaseisHref}
            class="inline-flex shrink-0 items-center gap-2 pb-1 text-sm font-semibold text-zinc-950 transition hover:text-orange"
          >
            {t('home.featured.all')}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="mt-8 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {featuredPlays.map((play) => (
            <PlayCard play={play} />
          ))}
        </div>
      </section>
    )
  }

  {
    latestNews.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl sm:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <SectionTitle
            eyebrow={t('page.nea.eyebrow')}
            title={t('page.nea.title')}
          />
          <a
            href={neaHref}
            class="inline-flex shrink-0 items-center gap-2 pb-1 text-sm font-semibold text-zinc-950 transition hover:text-orange"
          >
            {t('home.news.all')}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-3">
          {latestNews.map((post) => (
            <li>
              <a
                href={localizedPath(`/nea/${post.id}`, locale)}
                class="group block"
              >
                {post.data.thumbnail ? (
                  <div class="overflow-hidden">
                    <Image
                      src={post.data.thumbnail}
                      alt=""
                      widths={[480, 720]}
                      sizes="(min-width:640px) 33vw, 100vw"
                      width={720}
                      height={405}
                      loading="lazy"
                      class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                    />
                  </div>
                ) : (
                  <div class="flex aspect-video w-full items-center justify-center bg-zinc-950/5 px-4 text-center font-display text-2xl text-zinc-950/40">
                    {post.data.title}
                  </div>
                )}
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-orange">
                  {fmtDate(post.data.publishDate)}
                </p>
                <h3 class="mt-1 font-display text-xl leading-snug text-zinc-950 transition group-hover:text-orange">
                  {post.data.title}
                </h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Programme band: the site's one dark moment below the hero; runs
       flush into the orange footer (flush layout has no bottom padding). -->
  <section class="-mx-4 mt-16 bg-zinc-950 sm:mt-24">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange">
          {t('page.programma.eyebrow')}
        </p>
        <h2 class="mt-2 font-display text-3xl leading-tight text-zinc-50 sm:text-4xl">
          {format(t('page.programma.heading'), { season: SEASON })}
        </h2>
        <p class="mt-3 max-w-xl text-sm text-zinc-50/70">
          {t('page.programma.soon')}
        </p>
      </div>
      <a
        href={programmaHref}
        class="inline-flex shrink-0 items-center gap-2 self-start border border-zinc-50/50 px-6 py-3 text-sm font-semibold text-zinc-50 transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:self-auto"
      >
        {t('home.program.cta')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
