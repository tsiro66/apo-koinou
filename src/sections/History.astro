---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import istoria from "../assets/istoria.jpg";
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
} from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Long-form history content lives in the `selides` collection, one Markdown
// entry per locale: src/content/selides/<locale>/istoria.md
const entry = await getEntry("selides", `${locale}/istoria`);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;

// "On this page" rail: h2 headings of the entry. Slugs come from the same
// markdown pipeline as the rendered headings, so anchors always match.
const sections = (rendered?.headings ?? []).filter((h) => h.depth === 2);
---

<BaseLayout
  title={t("page.istoria.title")}
  description={entry?.data.seoDescription ?? t("page.istoria.intro")}
  canonicalPath="/istoria"
>
  <div class="mx-auto max-w-6xl">
    <Breadcrumbs
      crumbs={[
        { label: t("nav.home"), href: localizedPath("/", locale) },
        { label: t("page.istoria.title") },
      ]}
    />
    <div class="mt-6">
      <SectionTitle
        eyebrow={t("page.istoria.eyebrow")}
        title={t("page.istoria.heading")}
        as="h1"
      />
    </div>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-zinc-950/80">
      {t("page.istoria.intro")}
    </p>
  </div>

  <!-- Company banner: full-bleed break between the header and the body.
       The panoramic group photo runs edge to edge, hero-style. -->
  <figure class="-mx-4 mt-12">
    <Image
      src={istoria}
      alt={t("page.istoria.image_alt")}
      widths={[960, 1440, 2048]}
      sizes="100vw"
      width={2048}
      height={851}
      loading="eager"
      class="h-auto w-full object-cover"
    />
    <figcaption class="mx-auto mt-2 max-w-6xl px-4 text-sm text-zinc-600">
      {t("page.istoria.caption")}
    </figcaption>
  </figure>

  <!-- Body: prose column + sticky "on this page" rail on wide screens. -->
  <div
    class="mx-auto mt-12 grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-x-12"
  >
    <div class="min-w-0 max-w-3xl">
      {
        Content ? (
          <div class="prose">
            <Content />
          </div>
        ) : (
          <p class="text-zinc-600">{t("page.istoria.empty")}</p>
        )
      }
    </div>

    {
      sections.length > 0 && (
        <aside class="hidden lg:block">
          <nav
            data-toc
            class="sticky top-24"
            aria-label={t("page.istoria.toc")}
          >
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-600">
              {t("page.istoria.toc")}
            </p>
            <ul class="mt-3 space-y-2 border-l border-zinc-950/10 pl-4 text-sm">
              {sections.map((h) => (
                <li class="relative">
                  <a
                    href={`#${h.slug}`}
                    class="text-zinc-600 transition hover:text-orange"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Scrollspy indicator: the in-view section's link turns orange and a tick
     overlays the rail line beside it. [data-active] is toggled by JS. */
  nav li[data-active]::before {
    content: "";
    position: absolute;
    left: calc(-1rem - 1px); /* ul padding + rail border width */
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-orange);
  }
  nav a[data-active] {
    color: var(--color-orange);
    font-weight: 600;
  }
</style>

<script src="./History.ts"></script>
