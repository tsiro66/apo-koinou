---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../consts";
import {
  getLocaleFromUrl,
  useTranslations,
  localizedPath,
} from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const parastaseisHref = localizedPath("/parastaseis", locale);

// Display-only grouping (697 499 1255); the tel: href keeps the
// international +30 form so the link also works from abroad.
const phoneDisplay = SITE.phone.replace(/(\d{3})(\d{3})(\d{4})/, "$1 $2 $3");

// Only platforms with a URL configured in consts.ts are rendered
// (Instagram is currently empty and drops out automatically).
const socials = [
  { label: "YouTube", href: SITE.social.youtube, icon: "youtube" },
  { label: "Facebook", href: SITE.social.facebook, icon: "facebook" },
  { label: "Instagram", href: SITE.social.instagram, icon: "instagram" },
].filter((s) => s.href);
---

<BaseLayout title={t("page.epikoinonia.title")} canonicalPath="/epikoinonia">
  <div class="mx-auto max-w-6xl">
    <!-- One shared measure for breadcrumbs, heading, lead and rows:
         a single editorial column instead of mixed widths. -->
    <div class="max-w-3xl">
      <Breadcrumbs
        crumbs={[
          { label: t("nav.home"), href: localizedPath("/", locale) },
          { label: t("page.epikoinonia.title") },
        ]}
      />
      <div class="mt-6">
        <SectionTitle
          eyebrow={t("page.epikoinonia.eyebrow")}
          title={t("page.epikoinonia.heading")}
        />
      </div>
      <!-- Lead: clearly subordinate to the heading — sans, smaller and
           muted, so the display-serif heading stays the star. -->
      <p
        class="mt-6 max-w-xl text-base leading-relaxed text-zinc-950/75 sm:text-lg"
      >
        {t("page.epikoinonia.body")}
      </p>

      <!-- Contact rows: three rows, one grammar. Every row is the same
           two-column grid — uppercase orange label left, value right —
           so email, phone and social read as a single component.
           Mobile stacks label over value; only the arrow moves on
           hover. Static links, no JS. -->
      <ul class="mt-10 border-t border-zinc-950/10">
        <li class="border-b border-zinc-950/10">
          <a
            href={`mailto:${SITE.email}`}
            class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-5"
          >
            <span
              class="text-xs font-semibold uppercase tracking-[0.2em] text-orange"
            >
              {t("page.epikoinonia.email_label")}
            </span>
            <span
              class="inline-flex items-center gap-2 font-display text-lg text-zinc-950 sm:text-xl"
            >
              <span class="[overflow-wrap:anywhere]">{SITE.email}</span>
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
                >→</span
              >
            </span>
          </a>
        </li>
        <li class="border-b border-zinc-950/10">
          <a
            href={`tel:+30${SITE.phone}`}
            class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-5"
          >
            <span
              class="text-xs font-semibold uppercase tracking-[0.2em] text-orange"
            >
              {t("page.epikoinonia.phone_label")}
            </span>
            <span
              class="inline-flex items-center gap-2 font-display text-lg text-zinc-950 sm:text-xl"
            >
              {phoneDisplay}
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
                >→</span
              >
            </span>
          </a>
        </li>
        <!-- Social: same row grid, but the value column holds two links
             (external → ↗). Stacked below the label on phones, aligned
             to the value edge on desktop. -->
        <li class="border-b border-zinc-950/10">
          <div
            class="flex flex-col gap-3 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-5"
          >
            <span
              class="text-xs font-semibold uppercase tracking-[0.2em] text-orange"
            >
              {t("page.epikoinonia.social_label")}
            </span>
            <div class="flex flex-col items-start gap-2 sm:items-end">
              {
                socials.map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2 font-display text-lg text-zinc-950 sm:text-xl"
                  >
                    {s.icon === "youtube" && (
                      <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        class="h-5 w-5 shrink-0 fill-current"
                      >
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                      </svg>
                    )}
                    {s.icon === "facebook" && (
                      <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        class="h-5 w-5 shrink-0 fill-current"
                      >
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.125 10.954 9.75 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.875 23.027 24 18.062 24 12.073z" />
                      </svg>
                    )}
                    {s.icon === "instagram" && (
                      <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        class="h-5 w-5 shrink-0 fill-current"
                      >
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
                      </svg>
                    )}
                    {s.label}
                    <span
                      aria-hidden="true"
                      class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    >
                      ↗
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <!-- CTA band: the orange bookend against the dark footer, mirroring
       the homepage programme band. The gap above it is deliberately
       tight (mt-12/sm:mt-16, vs mt-16/sm:mt-24 elsewhere) so the hand-off
       from the white section reads as one rhythm, not a jump.
       -mx-4 escapes main's horizontal padding for a full-bleed band;
       -mb-28 cancels main's pb-12 plus the footer's mt-16 so the two
       run flush together. -->
  <section class="-mx-4 -mb-28 mt-12 bg-orange text-zinc-50 sm:mt-16">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-50/80"
        >
          {t("page.epikoinonia.cta_eyebrow")}
        </p>
        <h2 class="mt-2 font-display text-3xl leading-tight sm:text-4xl">
          {t("page.epikoinonia.cta_heading")}
        </h2>
        <p class="mt-3 max-w-xl text-sm text-zinc-50/80">
          {t("page.epikoinonia.cta_body")}
        </p>
      </div>
      <a
        href={parastaseisHref}
        class="inline-flex shrink-0 items-center gap-2 self-start border border-zinc-50/50 px-6 py-3 text-sm font-semibold transition hover:border-zinc-50 hover:bg-zinc-50 hover:text-zinc-950 sm:self-auto"
      >
        {t("page.epikoinonia.cta_link")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
