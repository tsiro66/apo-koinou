---
import RepertoireDetail from "../../../sections/RepertoireDetail.astro";
import { getRepertoire } from "../../../utils/repertoire";

export async function getStaticPaths() {
  const entries = await getRepertoire();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<RepertoireDetail entry={entry} />
